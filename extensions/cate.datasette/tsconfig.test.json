{
  // Type-check config for the Vitest suite (Node unit tests over the pure
  // helpers in src/datasette.ts, src/scan.ts and src/proxy.ts).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020"],
    "types": ["node", "vitest/globals"],
    "noEmit": true
  },
  "include": [
    "src/datasette.ts",
    "src/scan.ts",
    "src/proxy.ts",
    "src/datasette.test.ts",
    "src/scan.test.ts",
    "src/proxy.test.ts"
  ]
}
