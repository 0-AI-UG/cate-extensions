{
  // Node server build: src/server.ts + src/shared/* -> dist/ (CommonJS), run via
  // `node dist/server.js`. rootDir=src preserves the shared/ subdir so the
  // emitted require('./shared/taskmaster') resolves to dist/shared/taskmaster.js.
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2020"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src/server.ts", "src/shared/**/*.ts"],
  "exclude": ["src/shared/**/*.test.ts"]
}
