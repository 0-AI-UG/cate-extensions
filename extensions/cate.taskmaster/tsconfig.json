{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src/public", "src/shared", "src/_kit"],
  // service-detect.ts is a server-only kit module (node: APIs); this panel never
  // imports it, so keep it out of the DOM/no-node typecheck.
  "exclude": ["src/_kit/service-detect.ts"]
}
