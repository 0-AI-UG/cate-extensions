{
  // Node server build: src/server.ts -> dist/server.js (CommonJS, run via `node dist/server.js`).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2020"],
    "types": ["node"],
    "rootDir": "src",
    "outDir": "dist"
  },
  "files": ["src/server.ts"]
}
