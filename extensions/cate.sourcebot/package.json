{
  "name": "cate.sourcebot",
  "version": "0.1.0",
  "private": true,
  "description": "Sourcebot code-search extension for Cate (connects to a user-run Sourcebot instance).",
  "scripts": {
    "build": "tsc -p tsconfig.server.json && npm run build:panel && node ./copy-static.mjs",
    "build:panel": "esbuild src/public/app.ts --bundle --format=iife --outfile=dist/public/app.js",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.browser.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
