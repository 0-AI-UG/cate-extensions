{
  "name": "cate.mcphub",
  "version": "1.0.0",
  "private": true,
  "description": "MCPHub wrapper, a server-backed Cate extension. Embeds the MCPHub dashboard reverse-proxied through a loopback-bound wrapper.",
  "scripts": {
    "build": "tsc -p tsconfig.server.json && tsc -p tsconfig.browser.json && node ./copy-static.mjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.browser.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
