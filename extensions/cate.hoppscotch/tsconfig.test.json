{
  // Type-check config for the Vitest suite (Node unit tests over the pure
  // helpers in src/config.ts, src/pscotch.ts and src/rewrite.ts).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020"],
    "types": ["node", "vitest/globals"],
    "noEmit": true
  },
  "include": [
    "src/config.ts",
    "src/pscotch.ts",
    "src/rewrite.ts",
    "src/config.test.ts",
    "src/pscotch.test.ts",
    "src/rewrite.test.ts"
  ]
}
